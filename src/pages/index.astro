---
import Layout from '../layouts/Layout.astro';
import PostRow from '../components/PostRow.astro';
import Runner from '../components/Runner';
import site from '../../content/site.json';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
---

<Layout title="Home" current="home" preloadLandscape>
  <main id="main">
    <section class="journey" aria-label="Mountain introduction">
      <div class="scene">
        <img class="landscape" src="/assets/mountains.webp" width="1536" height="1024" alt="Layered green mountain ridges made of textured paper, fading into mist" fetchpriority="high" />
        <div class="hero-copy">
          <div class="eyebrow">{site.heroLabel}</div>
          <h1>{site.headline}</h1>
        </div>
        <a class="scroll-cue" href="/blog/">Read the blog</a>
      </div>
    </section>
    <Runner client:load />
    <section class="intro" id="about">
      <div class="portrait">
        <img src={site.portrait} alt={site.name} width="240" height="240" />
      </div>
      <div class="intro-copy">
        <div class="eyebrow">Hi, I’m Matthew.</div>
        <h2>{site.introHeading} <em>{site.introEmphasis}</em></h2>
        <p>{site.intro}</p>
        <p class="intro-aside">{site.introAside}</p>
        <a class="text-link" href="/about/">A little about me <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="writing" aria-labelledby="latest">
      <div class="section-heading">
        <h2 class="section-title" id="latest">Blog.</h2>
        <a class="text-link" href="/blog/">All writing <span aria-hidden="true">↗</span></a>
      </div>
      {posts.slice(0, 10).map((post) => <PostRow post={post} />)}
    </section>
  </main>
</Layout>
