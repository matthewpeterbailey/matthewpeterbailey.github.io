---
import Layout from '../layouts/Layout.astro';
import About from '../content/about/about.md';
import site from '../../content/site.json';
---

<Layout title="About me" current="about">
  <main class="page article" id="main">
    <h1>Hello, I'm Matthew.</h1>
    <div class="prose"><About /></div>
    <div class="about-links">
      <a class="text-link" href={site.github}>GitHub ↗</a>
      <a class="text-link" href={site.linkedin}>LinkedIn ↗</a>
    </div>
  </main>
</Layout>
